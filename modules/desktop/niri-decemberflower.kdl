// Included at the top of config.kdl, so anything set below there wins over
// this. Sections merge across includes — only what differs belongs here.
layout {
    // Laptop screen: open full width, Mod+R toggles half <-> full.
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }
    default-column-width { proportion 1.0; }
}
